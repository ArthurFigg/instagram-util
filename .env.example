# Obrigatório: token do seu bot, criado no Telegram com o @BotFather.
TELEGRAM_TOKEN=

# Seu id no Telegram. Deixe vazio na primeira vez: o bot responde com ele.
TELEGRAM_ID_AUTORIZADO=

# Opcional: sem token o GitHub limita a 60 consultas por hora.
GITHUB_TOKEN=

# Opcional: pasta do Obsidian onde criar uma nota por repositório.
# Vazio = não grava nota. Exemplo: C:\Users\voce\Obsidian\Repositorios
OBSIDIAN_PASTA_REPOSITORIOS=

# Opcional: nota-índice que ganha uma linha por nota nova. Exemplo: Indice.md
OBSIDIAN_ARQUIVO_INDICE=

# Opcional: notas linkadas no rodapé de cada nota, em JSON. Exemplo: ["Indice"]
OBSIDIAN_LINKS_RODAPE=

# Opcional: propriedade "status" gravada em toda nota nova. Exemplo: novo
OBSIDIAN_STATUS_INICIAL=
